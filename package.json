{
  "name": "@local/security-scan",
  "version": "0.3.0",
  "private": true,
  "description": "Local, reusable security scan orchestrator for Cursor",
  "type": "module",
  "bin": {
    "security-scan": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:containers": "npm run build && node dist/cli.js scan --repo . --mode standard --timeout 10m",
    "lint": "eslint .",
    "test:cloudflare-validators": "node --test third-party/cloudflare-security-audit/validate-findings.test.cjs",
    "verify": "npm run test && npm run typecheck && npm run lint && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@types/node": "22.18.12",
    "eslint": "9.38.0",
    "globals": "16.4.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  },
  "license": "Apache-2.0"
}
